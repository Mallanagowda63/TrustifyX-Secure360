# ─── TrustifyX Secure360 example configuration ───
# Copy to `.env` and replace every placeholder. Never commit real secrets.

NODE_ENV=development
# Public base URL of the dashboard (used in emails, CSRF origin checks, cookies)
APP_URL=http://localhost:3000

# PostgreSQL (docker compose exposes it on 127.0.0.1:${POSTGRES_HOST_PORT:-5432})
# Change the host port if something else already listens on 5432
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql://trustifyx:trustifyx_dev_password@localhost:5432/secure360
# Used only by `npm run test:integration`
TEST_DATABASE_URL=postgresql://trustifyx:trustifyx_dev_password@localhost:5432/secure360_test
POSTGRES_PASSWORD=trustifyx_dev_password

REDIS_URL=redis://localhost:6379
# Production only (deploy/docker-compose.prod.yml enables Redis AUTH with it)
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Session lifetime in hours
SESSION_TTL_HOURS=168
# Allow public self-service signup (set false to make the platform invite-only)
ALLOW_SIGNUP=true
# true when behind nginx (uses X-Forwarded-For for client IP / rate limiting)
TRUST_PROXY=false

# ─── Email (SMTP). If unset, alerts are recorded as SKIPPED and not sent. ───
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TrustifyX Secure360 <alerts@example.com>"

# ─── Monitoring worker ───
MONITOR_CONCURRENCY=10
MONITOR_CONFIG_CONCURRENCY=3
MONITOR_TIMEOUT_MS=10000
MONITOR_MAX_REDIRECTS=5
# Consecutive failed checks before downtime is confirmed and alerted
MONITOR_DOWN_THRESHOLD=2
# Minimum seconds between manual rescans of one website
MONITOR_MANUAL_SCAN_COOLDOWN_SEC=120
# Minimum allowed availability interval (seconds)
MONITOR_MIN_INTERVAL_SEC=60
# Public DNS resolvers used for ownership verification and DNS monitoring (comma-separated).
# Leave empty to use the host's resolvers.
DNS_SERVERS=1.1.1.1,8.8.8.8,9.9.9.9
# Plan limit: websites per organization
MAX_WEBSITES_PER_ORG=25

# ─── Billing: Razorpay (start with TEST MODE keys: rzp_test_...) ───
# Dashboard → Account & Settings → API Keys. Never commit live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you choose when creating the webhook (see docs/BILLING.md)
RAZORPAY_WEBHOOK_SECRET=
# recurring = Razorpay Subscriptions (needs Subscriptions enabled on the account); prepaid = manual renewal
BILLING_MODE=recurring
# Annual plans (10 months' price for 12) are only offered when explicitly enabled
BILLING_ANNUAL_ENABLED=false
# GST in basis points (1800 = 18%); prices shown exclude GST unless BILLING_PRICES_INCLUDE_TAX=true
BILLING_TAX_RATE_BP=1800
BILLING_PRICES_INCLUDE_TAX=false
# Days of continued service after a failed renewal before monitoring pauses
BILLING_GRACE_DAYS=7
BILLING_PENDING_EXPIRY_HOURS=24
# Shown on invoices/receipts (REVIEW with your accountant before launch)
BILLING_SELLER_NAME="TrustifyX Private Limited"
BILLING_SELLER_ADDRESS=
BILLING_SELLER_GSTIN=
SUPPORT_EMAIL=support@trustifyx.com
SECURITY_EMAIL=security@trustifyx.com

# ─── AI assistant (Phase 2). Provider: anthropic | openai | none ───
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Optional: OpenAI-compatible base URL (e.g. Azure / self-hosted gateway)
AI_BASE_URL=
