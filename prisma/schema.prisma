// TrustifyX Secure360 - data model
// Every tenant-owned table carries `orgId` so that all queries can be scoped
// server-side to the caller's organization.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & tenancy ─────────────────────────────

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  isPlatformAdmin Boolean   @default(false)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  /// TOTP two-factor authentication. Secrets are AES-256-GCM encrypted (encryptSecret).
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  /// Enrollment in progress: secret shown as QR code, not active until confirmed with a code.
  totpPendingEnc  String?
  totpPendingAt   DateTime?
  /// Last accepted TOTP time step; codes at or before it are rejected (replay prevention).
  totpLastStep    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     Membership[]
  recoveryCodes   MfaRecoveryCode[]
  mfaChallenges   MfaChallenge[]
  mfaResets       MfaResetRequest[]
  sessions        Session[]
  notificationPrefs NotificationPreference[]
  passwordResets    PasswordResetToken[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Owners and admins must use two-factor authentication to access this organization.
  requireMfaForPrivileged Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  invitations   Invitation[]
  websites      Website[]
  auditLogs     AuditLog[]
  findings      Finding[]
  incidents     Incident[]
  alerts        Alert[]
  integrations  Integration[]
  reports       Report[]
  aiInteractions AiInteraction[]
  subscriptions  Subscription[]
  payments       Payment[]
  invoices       Invoice[]
  notificationPrefs NotificationPreference[]
  cloudflareConnection CloudflareConnection?
  cloudflareZones      CloudflareZone[]
  protectionConfigs    ProtectionConfiguration[]
  protectionChanges    ProtectionChangeAudit[]
  securityEvents       SecurityEvent[]
  vulnerabilityScans   VulnerabilityScan[]
  vulnerabilityFindings VulnerabilityFinding[]
  scanSchedules        ScanSchedule[]
  serverAgents         ServerAgent[]
  serverEvents         ServerSecurityEvent[]
  backupStatuses       BackupStatus[]
  restoreTests         RestoreTest[]
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole      @default(MEMBER)
  createdAt DateTime     @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Session {
  id          String   @id @default(cuid())
  // SHA-256 of the opaque session token; the raw token only lives in the cookie.
  tokenHash   String   @unique
  csrfToken   String
  userId      String
  activeOrgId String?
  /// Which website the session belongs to (MARKETING | PORTAL); cookies are host-only.
  site        String   @default("MARKETING")
  /// Sessions created through SSO share a group so logout on one site ends both.
  ssoGroupId  String?
  persistent  Boolean  @default(true)
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([ssoGroupId])
}

/// One-time authorization code for moving a signed-in user between the marketing site and the
/// portal. Only the hash is stored; codes live 60 seconds and can be redeemed once, on the
/// target site only.
model SsoCode {
  id         String    @id @default(cuid())
  codeHash   String    @unique
  userId     String
  orgId      String?
  targetSite String
  /// Hash of the OAuth-style state bound to a cookie on the target site (prevents login CSRF).
  stateHash  String
  nextPath   String
  groupId    String
  persistent Boolean   @default(false)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use recovery codes for two-factor authentication (SHA-256 of user id + code).
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Password verified, second factor pending. The raw token lives only in an HttpOnly cookie.
model MfaChallenge {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  site       String
  persistent Boolean  @default(true)
  attempts   Int      @default(0)
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Self-service removal of two-factor authentication when both the authenticator and the recovery
/// codes are lost: password + email confirmation + a waiting period, with notifications and a
/// cancel link. Nobody (including TrustifyX staff) can skip these steps.
model MfaResetRequest {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  /// Email link must be confirmed before this time.
  expiresAt   DateTime
  confirmedAt DateTime?
  /// Two-factor authentication is removed at the first sign-in after this time.
  effectiveAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  ip          String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        OrgRole   @default(MEMBER)
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  userId     String?
  action     String
  targetType String?
  targetId   String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
}

// ───────────────────────────── Websites & monitoring ─────────────────────────────

enum PausedReason {
  USER
  SUBSCRIPTION_INACTIVE
  PLAN_LIMIT
}

enum WebsiteStatus {
  PENDING_VERIFICATION
  CONNECTED
  MONITORING_PAUSED
  VERIFICATION_FAILED
}

enum VerificationMethod {
  DNS_TXT
  HTTP_FILE
}

enum SiteState {
  UNKNOWN
  UP
  DOWN
}

model Website {
  id                     String              @id @default(cuid())
  orgId                  String
  displayName            String
  url                    String // normalized https://hostname/
  hostname               String
  status                 WebsiteStatus       @default(PENDING_VERIFICATION)
  verificationToken      String
  verificationMethod     VerificationMethod?
  verifiedAt             DateTime?
  lastVerificationAt     DateTime?
  lastVerificationError  String?
  authorizationConfirmedAt DateTime?
  authorizedById         String?
  // Ownership is re-checked daily; monitoring stops after repeated failures.
  lastReverifiedAt       DateTime?
  reverifyFailures       Int                 @default(0)
  // Why monitoring is paused: by the customer, or automatically by billing (resumes automatically).
  pausedReason           PausedReason?

  availabilityIntervalSec Int                @default(300)
  configIntervalSec       Int                @default(21600)
  lastAvailabilityCheckAt DateTime?
  lastConfigCheckAt       DateTime?
  lastManualScanAt        DateTime?

  state                  SiteState           @default(UNKNOWN)
  consecutiveFailures    Int                 @default(0)
  lastResponseTimeMs     Int?
  lastStatusCode         Int?
  tlsValidTo             DateTime?

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  checks          AvailabilityCheck[]
  snapshots       ConfigSnapshot[]
  configChanges   ConfigChange[]
  findings        Finding[]
  incidents       Incident[]
  cloudflareZones CloudflareZone[]
  vulnerabilityScans VulnerabilityScan[]
  vulnerabilityFindings VulnerabilityFinding[]
  scanSchedule    ScanSchedule?
  backupStatus    BackupStatus?
  restoreTests    RestoreTest[]

  @@unique([orgId, hostname])
  @@index([status])
  @@index([orgId])
}

model AvailabilityCheck {
  id             String   @id @default(cuid())
  websiteId      String
  orgId          String
  checkedAt      DateTime @default(now())
  success        Boolean
  statusCode     Int?
  responseTimeMs Int?
  redirectCount  Int      @default(0)
  finalUrl       String?
  attempts       Int      @default(1)
  error          String?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, checkedAt])
  @@index([orgId, checkedAt])
}

model ConfigSnapshot {
  id        String   @id @default(cuid())
  websiteId String
  orgId     String
  checkedAt DateTime @default(now())
  tls       Json?
  headers   Json?
  https     Json?
  dns       Json?
  errors    Json?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, checkedAt])
}

model ConfigChange {
  id            String   @id @default(cuid())
  websiteId     String
  orgId         String
  detectedAt    DateTime @default(now())
  category      String // tls | headers | https | dns
  field         String
  previousValue String?
  newValue      String?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, detectedAt])
  @@index([orgId, detectedAt])
}

// ───────────────────────────── Findings ─────────────────────────────

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  FALSE_POSITIVE
}

model Finding {
  id             String        @id @default(cuid())
  orgId          String
  websiteId      String
  ruleId         String
  category       String
  title          String
  severity       Severity
  status         FindingStatus @default(OPEN)
  evidence       Json
  description    String
  remediation    String
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  resolvedAt     DateTime?
  statusNote     String?
  statusChangedById String?
  statusChangedAt   DateTime?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, ruleId])
  @@index([orgId, status])
}

// ───────────────────────────── Incidents & alerts ─────────────────────────────

enum IncidentType {
  DOWNTIME
  TLS_EXPIRY
  TLS_INVALID
}

model Incident {
  id         String       @id @default(cuid())
  orgId      String
  websiteId  String
  type       IncidentType
  startedAt  DateTime     @default(now())
  resolvedAt DateTime?
  details    Json?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([websiteId, type, resolvedAt])
}

enum AlertType {
  DOWNTIME
  RECOVERY
  TLS_EXPIRY
  FINDING_NEW
  FINDING_RESOLVED
  REPORT
  BILLING
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Alert {
  id        String      @id @default(cuid())
  orgId     String
  websiteId String?
  type      AlertType
  // Stable key for one logical notification, e.g. "down:<incidentId>".
  dedupeKey String
  recipient String
  subject   String
  status    AlertStatus
  error     String?
  createdAt DateTime    @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey, recipient])
  @@index([orgId, createdAt])
}

model NotificationPreference {
  id                 String  @id @default(cuid())
  orgId              String
  userId             String
  emailDowntime      Boolean @default(true)
  emailTlsExpiry     Boolean @default(true)
  emailFindings      Boolean @default(true)
  findingMinSeverity Severity @default(MEDIUM)
  emailWeeklyReport  Boolean @default(false)
  emailMonthlyReport Boolean @default(true)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

// ───────────────────────────── Phase 2: integrations, reports, AI ─────────────────────────────

enum IntegrationType {
  CLOUDFLARE_WAF
  WAZUH
  GITHUB
  OWASP_ZAP
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

model Integration {
  id                   String            @id @default(cuid())
  orgId                String
  type                 IntegrationType
  status               IntegrationStatus @default(NOT_CONNECTED)
  // AES-256-GCM ciphertext (see src/server/security/crypto.ts). Never returned by APIs.
  encryptedCredentials String?
  config               Json?
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, type])
}

enum ReportPeriod {
  WEEKLY
  MONTHLY
}

model Report {
  id          String       @id @default(cuid())
  orgId       String
  period      ReportPeriod
  periodStart DateTime
  periodEnd   DateTime
  summary     Json
  aiSummary   String?
  createdAt   DateTime     @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, period, periodStart])
  @@index([orgId, createdAt])
}

model AiInteraction {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  kind      String // explain_finding | prioritize | monthly_summary | explain_change | chat
  question  String?
  response  String
  provider  String
  model     String
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// ───────────────────────────── Billing ─────────────────────────────
// Prices are integers in paise. Entitlements are derived from Subscription rows whose state
// is only ever set from provider-verified data (Razorpay API / signed webhooks) or an
// explicit, audited complimentary grant. See src/server/billing/.

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum BillingMode {
  RECURRING
  PREPAID
  COMPLIMENTARY
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
  ABANDONED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum InvoiceStatus {
  ISSUED
  VOID
}

model PricingPlan {
  id                      String   @id @default(cuid())
  code                    String   @unique
  /// BASE = Starter/Growth/Business (one per organization); ADDON = optional extra such as Secure360 Protect.
  kind                    String   @default("BASE")
  name                    String
  tagline                 String
  description             String
  monthlyPricePaise       Int
  /// Null = annual billing not offered for this plan.
  annualPricePaise        Int?
  currency                String   @default("INR")
  maxWebsites             Int
  maxMembers              Int
  availabilityIntervalSec Int      @default(300)
  aiAssistant             Boolean  @default(false)
  scheduledReports        Boolean  @default(false)
  auditLogs               Boolean  @default(false)
  features                Json
  highlight               Boolean  @default(false)
  sortOrder               Int      @default(0)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  providerPlans ProviderPlan[]
  subscriptions Subscription[]
}

/// Razorpay plans are immutable, so each (plan, cycle, amount) maps to its own provider plan.
model ProviderPlan {
  id             String       @id @default(cuid())
  planId         String
  cycle          BillingCycle
  amountPaise    Int
  razorpayPlanId String       @unique
  createdAt      DateTime     @default(now())

  plan PricingPlan @relation(fields: [planId], references: [id])

  @@unique([planId, cycle, amountPaise])
}

model Subscription {
  id                     String             @id @default(cuid())
  orgId                  String
  planId                 String
  cycle                  BillingCycle
  mode                   BillingMode
  status                 SubscriptionStatus @default(PENDING_PAYMENT)
  /// Amount charged per cycle (incl. tax), fixed by the server at checkout.
  amountPaise            Int
  currency               String             @default("INR")
  razorpaySubscriptionId String?            @unique
  razorpayPlanId         String?
  /// Prepaid mode: the order awaiting payment for the next period.
  razorpayOrderId        String?            @unique
  providerStatus         String?
  paidCount              Int                @default(0)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  graceUntil             DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  endedAt                DateTime?
  /// Plan change: the subscription this one replaces once it becomes active.
  replacesSubscriptionId String?
  scheduledStartAt       DateTime?
  grantReason            String?
  createdById            String?
  lastSyncedAt           DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan     PricingPlan  @relation(fields: [planId], references: [id])
  payments Payment[]
  invoices Invoice[]

  @@index([orgId, status])
  @@index([status, currentPeriodEnd])
}

model Payment {
  id                String        @id @default(cuid())
  orgId             String
  subscriptionId    String?
  razorpayPaymentId String        @unique
  razorpayOrderId   String?
  razorpayInvoiceId String?
  amountPaise       Int
  currency          String        @default("INR")
  status            PaymentStatus
  method            String?
  errorCode         String?
  errorDescription  String?
  refundedPaise     Int           @default(0)
  capturedAt        DateTime?
  failedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  invoice      Invoice?

  @@index([orgId, createdAt])
  @@index([status, createdAt])
}

model Invoice {
  id             String        @id @default(cuid())
  orgId          String
  subscriptionId String
  paymentId      String        @unique
  number         String        @unique
  subtotalPaise  Int
  taxPaise       Int
  totalPaise     Int
  taxRateBp      Int
  currency       String        @default("INR")
  periodStart    DateTime?
  periodEnd      DateTime?
  billedTo       Json
  status         InvoiceStatus @default(ISSUED)
  issuedAt       DateTime      @default(now())

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  payment      Payment      @relation(fields: [paymentId], references: [id])

  @@index([orgId, issuedAt])
}

/// Signature-verified provider events only. Forged requests are never stored here, so they
/// cannot claim a real event id. The unique eventId makes retries and duplicates idempotent.
model PaymentWebhookEvent {
  id          String             @id @default(cuid())
  provider    String             @default("razorpay")
  eventId     String             @unique
  eventType   String
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
}

model BillingAuditLog {
  id             String   @id @default(cuid())
  orgId          String?
  actorType      String // USER | ADMIN | WEBHOOK | SYSTEM
  actorUserId    String?
  action         String
  subscriptionId String?
  paymentId      String?
  details        Json?
  createdAt      DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([action, createdAt])
}

model BillingCounter {
  key   String @id
  value Int    @default(0)
}

// ───────────────────────────── Website protection (Cloudflare) ─────────────────────────────

/// A customer's own Cloudflare account, connected with a scoped API token (never a password or
/// Global API Key). The token is AES-256-GCM encrypted and never returned by any API.
model CloudflareConnection {
  id             String    @id @default(cuid())
  orgId          String    @unique
  tokenEnc       String
  /// Last 4 characters, to help customers recognise which token is connected.
  tokenHint      String
  cfTokenId      String?
  /// ACTIVE | INVALID (verify failed, disabled or expired at Cloudflare)
  status         String    @default("ACTIVE")
  tokenExpiresAt DateTime?
  /// Result of read probes per capability, e.g. { zone: true, dns: true, waf: false, ... }
  permissions    Json?
  lastVerifiedAt DateTime?
  lastError      String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org   Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  zones CloudflareZone[]
}

/// A Cloudflare zone linked to a verified Secure360 website (zone name = website hostname or a parent domain).
model CloudflareZone {
  id               String    @id @default(cuid())
  orgId            String
  connectionId     String
  /// The verified website this zone protects (one zone per website; the zone may also cover other hostnames).
  websiteId        String    @unique
  cfZoneId         String
  name             String
  /// Cloudflare zone status: active | pending | initializing | moved | deleted | deactivated
  status           String
  /// Cloudflare plan legacy id: free | pro | business | enterprise (others kept verbatim)
  planCode         String?
  planName         String?
  nameServers      Json?
  paused           Boolean   @default(false)
  /// Detected protection capabilities for this zone (plan, permissions and API availability).
  capabilities     Json?
  /// Last read Cloudflare configuration (settings, DNS proxy status, rulesets) - observed state only.
  observed         Json?
  lastSyncedAt     DateTime?
  lastSyncError    String?
  /// Security-event coverage reported by Cloudflare GraphQL settings (enabled, notOlderThan, ...).
  eventCoverage    Json?
  eventsSyncedUntil DateTime?
  eventsError      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org        Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connection CloudflareConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  website    Website                   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  configs    ProtectionConfiguration[]
  changes    ProtectionChangeAudit[]
  events     SecurityEvent[]

  @@unique([orgId, cfZoneId])
  @@index([orgId])
}

/// A protection feature TrustifyX manages on a zone. Only rules/settings recorded here are ever
/// changed or reverted by TrustifyX; customer-created Cloudflare rules are never modified.
model ProtectionConfiguration {
  id          String    @id @default(cuid())
  orgId       String
  zoneRefId   String
  /// Feature key, e.g. always_use_https, min_tls_1_2, bot_fight_mode, managed_waf, rule:sensitive_files
  feature     String
  /// ACTIVE | PREVIEW (rule created but not enforcing) | DISABLED | FAILED
  status      String
  cfRulesetId String?
  cfRuleId    String?
  /// Value before TrustifyX changed it (used to revert settings).
  previous    Json?
  desired     Json?
  observed    Json?
  verifiedAt  DateTime?
  lastError   String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  zone CloudflareZone @relation(fields: [zoneRefId], references: [id], onDelete: Cascade)

  @@unique([zoneRefId, feature])
  @@index([orgId])
}

/// Append-only record of every protection change attempt and its verified result.
model ProtectionChangeAudit {
  id        String   @id @default(cuid())
  orgId     String
  zoneRefId String?
  feature   String
  /// APPLY | PREVIEW | ENFORCE | REVERT | CONNECT | DISCONNECT | ZONE_LINK
  action    String
  before    Json?
  after     Json?
  /// SUCCEEDED | FAILED | VERIFY_FAILED
  result    String
  error     String?
  userId    String?
  ip        String?
  createdAt DateTime @default(now())

  org  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  zone CloudflareZone? @relation(fields: [zoneRefId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
}

/// Edge security event imported from Cloudflare (firewallEventsAdaptive). One row per event;
/// counts are counts of events, not of unique attackers.
model SecurityEvent {
  id         String   @id @default(cuid())
  orgId      String
  zoneRefId  String
  /// Stable de-duplication key (Ray ID when available, else a hash of the event fields).
  eventKey   String
  occurredAt DateTime
  action     String
  source     String?
  ruleId     String?
  country    String?
  host       String?
  path       String?
  method     String?
  userAgent  String?
  clientIp   String?
  rayId      String?
  createdAt  DateTime @default(now())

  org  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  zone CloudflareZone @relation(fields: [zoneRefId], references: [id], onDelete: Cascade)

  @@unique([zoneRefId, eventKey])
  @@index([orgId, occurredAt])
  @@index([zoneRefId, occurredAt])
}

// ───────────────────────────── Vulnerability scanning (OWASP ZAP) ─────────────────────────────

/// One authorized OWASP ZAP scan of a verified website. PASSIVE = spider + passive rules only
/// (no attack payloads); ACTIVE = separately authorized, inside a maintenance window.
model VulnerabilityScan {
  id                   String    @id @default(cuid())
  orgId                String
  websiteId            String
  /// PASSIVE | ACTIVE
  type                 String
  /// QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  status               String    @default("QUEUED")
  /// Exact scope: only this origin is reachable through the scanner's scope proxy.
  targetUrl            String
  /// MANUAL | SCHEDULED
  trigger              String    @default("MANUAL")
  requestedById        String?
  /// The authorization statement the user confirmed (stored verbatim) and when.
  authorizationText    String
  authorizedAt         DateTime
  windowStart          DateTime?
  windowEnd            DateTime?
  progress             Int       @default(0)
  message              String?
  error                String?
  startedAt            DateTime?
  finishedAt           DateTime?
  cancelRequestedAt    DateTime?
  /// Requests allowed / refused by the scope proxy, ZAP exit code and versions.
  stats                Json?
  alertCount           Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org      Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website  Website                @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  findings VulnerabilityFinding[]

  @@index([orgId, createdAt])
  @@index([websiteId, createdAt])
  @@index([status])
}

/// A ZAP alert from a scan (one row per alert type, with sample instances).
model VulnerabilityFinding {
  id            String   @id @default(cuid())
  orgId         String
  scanId        String
  websiteId     String
  pluginId      String
  alertRef      String?
  name          String
  /// HIGH | MEDIUM | LOW | INFO (ZAP riskcode 3..0)
  risk          String
  /// HIGH | MEDIUM | LOW | CONFIRMED | FALSE_POSITIVE (ZAP confidence)
  confidence    String
  description   String
  solution      String?
  reference     String?
  cweId         Int?
  wascId        Int?
  /// Up to 10 sample instances: uri, method, param, evidence (truncated). Never attack payload bodies.
  instances     Json
  instanceCount Int
  createdAt     DateTime @default(now())

  org     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scan    VulnerabilityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  website Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([scanId, pluginId, alertRef])
  @@index([orgId, risk])
  @@index([websiteId, createdAt])
}

/// Recurring passive baseline scan for a verified website (active scans are never scheduled).
model ScanSchedule {
  id               String    @id @default(cuid())
  orgId            String
  websiteId        String    @unique
  /// WEEKLY | MONTHLY
  frequency        String
  nextRunAt        DateTime
  enabled          Boolean   @default(true)
  authorizationText String
  authorizedById   String
  authorizedAt     DateTime
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
}

// ───────────────────────────── Server security (Wazuh agents) ─────────────────────────────

/// A customer server registered with the TrustifyX Wazuh manager. Agents are pre-registered via
/// the Wazuh API and mapped to the organization by agent ID (never by a group the agent claims).
model ServerAgent {
  id                String    @id @default(cuid())
  orgId             String
  displayName       String
  /// VPS | DEDICATED | CLOUD_VM | SHARED_HOSTING
  environment       String
  /// LINUX_DEB | LINUX_RPM | WINDOWS | MACOS
  os                String
  /// NOT_COMPATIBLE | PENDING_INSTALL | NEVER_CONNECTED | ACTIVE | DISCONNECTED | REMOVED
  status            String
  wazuhAgentId      String?
  wazuhAgentName    String?
  /// Enrollment key, encrypted, kept only until the agent first connects.
  keyEnc            String?
  agentVersion      String?
  osName            String?
  lastKeepAlive     DateTime?
  /// First time the agent was seen connected (data flowing).
  firstSeenAt       DateTime?
  lastEventAt       DateTime?
  eventsSyncedUntil DateTime?
  lastSyncError     String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org    Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events ServerSecurityEvent[]

  @@unique([wazuhAgentId])
  @@index([orgId])
}

/// A Wazuh alert for one of the organization's agents. Log excerpts are untrusted and never sent to AI.
model ServerSecurityEvent {
  id          String   @id @default(cuid())
  orgId       String
  agentRefId  String
  /// Wazuh alert id (unique per alert).
  eventKey    String
  occurredAt  DateTime
  ruleId      String?
  level       Int
  /// CRITICAL | HIGH | MEDIUM | LOW | INFO (from the Wazuh rule level)
  severity    String
  /// FILE_INTEGRITY | MALWARE | ROOTKIT | AUTHENTICATION | SECURITY_LOG
  category    String
  description String
  groups      Json
  filePath    String?
  fileEvent   String?
  location    String?
  logExcerpt  String?
  createdAt   DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent ServerAgent  @relation(fields: [agentRefId], references: [id], onDelete: Cascade)

  @@unique([agentRefId, eventKey])
  @@index([orgId, occurredAt])
}

// ───────────────────────────── Backup & recovery ─────────────────────────────

/// Backup set-up for a website. Without a backup-provider integration every value is reported by
/// the customer (source = CUSTOMER_REPORTED) and is shown as such; TrustifyX never claims to have verified it.
model BackupStatus {
  id               String    @id @default(cuid())
  orgId            String
  websiteId        String    @unique
  /// HOSTING_PROVIDER | CONTROL_PANEL | PLUGIN | CUSTOM_SCRIPT | NONE | UNKNOWN
  method           String
  /// DAILY | WEEKLY | MONTHLY | NONE | UNKNOWN
  frequency        String
  /// SEPARATE_LOCATION | SAME_SERVER | UNKNOWN
  storage          String
  includesFiles    Boolean?
  includesDatabase Boolean?
  encrypted        Boolean?
  retentionDays    Int?
  lastBackupAt     DateTime?
  /// CUSTOMER_REPORTED (no integration yet) | INTEGRATION_VERIFIED
  source           String    @default("CUSTOMER_REPORTED")
  notes            String?
  updatedById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// A restore test the customer performed (history). TrustifyX never runs restores.
model RestoreTest {
  id              String   @id @default(cuid())
  orgId           String
  websiteId       String
  testedAt        DateTime
  /// SUCCESS | PARTIAL | FAILED
  result          String
  durationMinutes Int?
  notes           String?
  recordedById    String
  createdAt       DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([orgId, testedAt])
  @@index([websiteId, testedAt])
}
